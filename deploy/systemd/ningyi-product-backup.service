[Unit]
Description=Create and verify Ningyi product database backup
After=ningyi-web.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=ningyi
Group=ningyi
WorkingDirectory=/opt/ningyi-ai-website
EnvironmentFile=/etc/ningyi/product.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node scripts/product-backup.mjs
Restart=on-failure
RestartSec=5m
TimeoutStartSec=30m
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
