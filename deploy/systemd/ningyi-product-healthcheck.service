[Unit]
Description=Check Ningyi product pipeline health
After=ningyi-web.service ningyi-product-worker.service
OnFailure=ningyi-product-recovery.service

[Service]
Type=oneshot
User=ningyi
Group=ningyi
WorkingDirectory=/opt/ningyi-ai-website
EnvironmentFile=/etc/ningyi/product.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node scripts/product-healthcheck.mjs
TimeoutStartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
