# Install as /etc/ningyi/product.env, owned by root with mode 0600.
PRODUCT_APP_ORIGIN=http://127.0.0.1:3000
PRODUCT_DB_PATH=/var/lib/ningyi/product.db
PRODUCT_PRIVATE_STORAGE_PATH=/var/lib/ningyi/private
PRODUCT_BACKUP_PATH=/var/lib/ningyi/backups
PRODUCT_BACKUP_RETENTION_DAYS=14
PRODUCT_SESSION_SECRET=replace-with-at-least-32-random-bytes
PRODUCT_WORKER_SECRET=replace-with-a-different-random-secret
PRODUCT_BACKUP_ENCRYPTION_KEY=replace-with-a-third-independent-random-secret
PRODUCT_DOWNLOAD_SECRET=replace-with-a-fourth-independent-random-secret
PRODUCT_DOWNLOAD_TTL_SECONDS=120

# Model providers. Keep the low-cost and formal routes separate.
PRODUCT_FREE_MODEL_PROVIDER=openai
PRODUCT_FREE_MODEL=gpt-5-mini
PRODUCT_FREE_MODEL_VERSION=gpt-5-mini
PRODUCT_FREE_PROMPT_VERSION=free-analysis-v1
PRODUCT_FORMAL_MODEL_PROVIDER=openai
PRODUCT_FORMAL_MODEL=gpt-5.4
PRODUCT_FORMAL_MODEL_VERSION=gpt-5.4
PRODUCT_FORMAL_PROMPT_VERSION=formal-analysis-v1
PRODUCT_SOURCE_PARSER_VERSION=source-parser-v1
PRODUCT_VISION_PROMPT_VERSION=media-analysis-v1
PRODUCT_VISION_MODEL_VERSION=provider-current
PRODUCT_OCR_PROMPT_VERSION=ocr-request-v1
PRODUCT_OCR_MODEL_VERSION=provider-current
PRODUCT_MEDIA_PARSER_VERSION=media-parser-v1
OPENAI_API_KEY=replace-with-provider-key
PRODUCT_PROVIDER_CHECK_MODEL=gpt-5-nano

# Runtime recovery defaults.
PRODUCT_ACCEPTANCE_FAULT_PROBES=0
PRODUCT_WORKER_FATAL_FAILURE_THRESHOLD=12
PRODUCT_DELIVERABLE_RECONCILE_BATCH=4
PRODUCT_KNOWLEDGE_RECONCILE_BATCH=4
PRODUCT_OPS_KNOWLEDGE_BACKLOG_MAX=20
PRODUCT_OPS_KNOWLEDGE_BACKLOG_AGE_MAX_SECONDS=300
PRODUCT_FORMAL_MATERIAL_SETTLE_SECONDS=10
PRODUCT_OPS_MATERIAL_CHANGE_DISCARD_MIN=3
PRODUCT_OPS_MATERIAL_CHANGE_DISCARD_RATE_MAX=0.1
PRODUCT_WORKER_STALE_SECONDS=45
PRODUCT_PIPELINE_HEALTH_STALE_SECONDS=60
PRODUCT_DELETION_HEALTH_STALE_SECONDS=60
PRODUCT_OPERATIONS_HEALTH_STALE_SECONDS=180
PRODUCT_STORAGE_HEALTH_STALE_SECONDS=46800
