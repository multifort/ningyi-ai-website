{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ningyi-ai.com/schemas/section-draft/v1.json",
  "title": "Ningyi Section Draft V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sectionId", "title", "revision", "blocks"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "sectionId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "claimType", "text", "sourceBlockIds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["heading", "paragraph", "list", "table", "callout"]},
          "claimType": {"enum": ["sourced_fact", "analysis", "recommendation", "transition"]},
          "text": {"type": "string", "minLength": 1},
          "sourceBlockIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}
        }
      }
    }
  }
}
