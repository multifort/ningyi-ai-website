{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ningyi-ai.com/schemas/product-api-catalog/v1.json",
  "title": "Ningyi Product API Catalog V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "basePath", "endpoints"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "basePath": {"const": "/api/product"},
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "path", "auth", "requestFields", "responseContract", "autoStartsProcessing", "implementation"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "method": {"enum": ["GET", "POST", "DELETE"]},
          "path": {"type": "string", "pattern": "^/api/product/"},
          "auth": {"enum": ["public", "product_session", "worker_bearer"]},
          "requestFields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "responseContract": {"type": "string", "minLength": 1},
          "autoStartsProcessing": {"type": "boolean"},
          "implementation": {"enum": ["implemented", "next", "planned"]}
        }
      }
    }
  }
}
