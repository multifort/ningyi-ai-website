{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ningyi-ai.com/schemas/section-ledger/v1.json",
  "title": "Ningyi Long Document Section Ledger V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "deliverableType", "projectRevisionId", "outlineHash", "status", "sections"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "documentId": {"type": "string", "format": "uuid"},
    "deliverableType": {"type": "string", "minLength": 1},
    "projectRevisionId": {"type": "string", "format": "uuid"},
    "outlineHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["pending", "in_progress", "complete", "failed"]},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "order", "dependencies", "status", "revision", "modelSlot", "contextPackHash", "contentHash", "summary", "sourceBlockIds", "estimatedOutputTokens", "failure"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "status": {"enum": ["pending", "in_progress", "drafted", "validated", "stale", "failed"]},
          "revision": {"type": "integer", "minimum": 0},
          "modelSlot": {"type": ["string", "null"]},
          "contextPackHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "contentHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "summary": {"type": ["string", "null"]},
          "sourceBlockIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
          "estimatedOutputTokens": {"type": "integer", "minimum": 0},
          "failure": {"type": ["string", "null"]}
        }
      }
    }
  }
}
