{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ningyi-ai.com/schemas/source-block/v1.json",
  "title": "Ningyi Source Block V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "fileRevisionId",
    "sourcePath",
    "sourceFormat",
    "blockType",
    "locator",
    "canonicalText",
    "structuredData",
    "contentHash",
    "parser",
    "confidence",
    "warnings",
    "classification"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid"},
    "fileRevisionId": {"type": "string", "format": "uuid"},
    "sourcePath": {"type": "string", "minLength": 1},
    "sourceFormat": {"enum": ["docx", "pdf", "xlsx", "csv", "txt", "pptx", "image"]},
    "blockType": {"enum": ["paragraph", "heading", "table", "cell_range", "image", "chart", "slide", "note", "shape", "page_region", "template_element"]},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {"type": ["integer", "null"], "minimum": 1},
        "slide": {"type": ["integer", "null"], "minimum": 1},
        "sheet": {"type": ["string", "null"]},
        "cellRange": {"type": ["string", "null"]},
        "paragraph": {"type": ["integer", "null"], "minimum": 1},
        "table": {"type": ["integer", "null"], "minimum": 1},
        "row": {"type": ["integer", "null"], "minimum": 1},
        "block": {"type": ["integer", "null"], "minimum": 1},
        "shape": {"type": ["integer", "null"], "minimum": 1},
        "bbox": {
          "type": ["array", "null"],
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "canonicalText": {"type": "string", "minLength": 1},
    "structuredData": {"type": ["object", "array", "null"]},
    "mediaArtifactId": {"type": ["string", "null"], "format": "uuid"},
    "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "classification": {"enum": ["project_content", "template_style", "brand_asset", "unknown"]}
  }
}
