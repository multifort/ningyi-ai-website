{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ningyi-ai.com/schemas/user-progress/v1.json",
  "title": "Ningyi User-visible Progress V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "stage", "progressPercent", "headline", "detail", "requiresUserAction", "deliverables"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "status": {"enum": ["processing", "partially_available", "available", "recovering", "blocked"]},
    "stage": {"enum": ["understanding", "forming_content", "checking", "creating_files", "complete", "recovering"]},
    "progressPercent": {"type": "integer", "minimum": 0, "maximum": 100},
    "headline": {"type": "string", "minLength": 1},
    "detail": {"type": "string", "minLength": 1},
    "requiresUserAction": {"type": "boolean"},
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "availableFormats", "progressPercent"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["waiting", "generating", "checking", "creating_files", "available", "affected", "failed"]},
          "availableFormats": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "progressPercent": {"type": "integer", "minimum": 0, "maximum": 100}
        }
      }
    }
  }
}
