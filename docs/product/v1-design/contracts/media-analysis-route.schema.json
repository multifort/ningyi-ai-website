{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ningyi-ai.com/schemas/media-analysis-route/v1.json",
  "title": "Ningyi Media Analysis Route V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourcePath", "sourceFormat", "page", "route", "reasonCodes", "signals", "fallbackRoute", "requiresModel"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "sourcePath": {"type": "string", "minLength": 1},
    "sourceFormat": {"enum": ["pdf", "image", "pptx"]},
    "page": {"type": ["integer", "null"], "minimum": 1},
    "route": {"enum": ["deterministic_text", "ocr_standard", "vision_low_cost", "vision_premium"]},
    "reasonCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nativeTextChars", "hasTextLayer", "ocrConfidence", "layoutComplexity"],
      "properties": {
        "nativeTextChars": {"type": "integer", "minimum": 0},
        "hasTextLayer": {"type": "boolean"},
        "ocrConfidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "layoutComplexity": {"enum": ["low", "medium", "high", "unknown"]}
      }
    },
    "fallbackRoute": {"enum": ["none", "vision_low_cost", "vision_premium"]},
    "requiresModel": {"type": "boolean"}
  }
}
