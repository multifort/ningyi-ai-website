{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ningyi-ai.com/schemas/deliverable-generation-plan/v1.json",
  "title": "Ningyi Deliverable Generation Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "deliverables", "contentModules", "renderJobs", "costSummary"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "status": {"enum": ["ready", "split_required", "deferred_budget"]},
    "deliverables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "contentModules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "taskType", "deliverables", "inputTokens", "outputTokens", "dispatchStatus", "slotId", "weightedCost"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "taskType": {"type": "string", "minLength": 1},
          "deliverables": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "inputTokens": {"type": "integer", "minimum": 0},
          "outputTokens": {"type": "integer", "minimum": 0},
          "dispatchStatus": {"enum": ["ready", "deterministic", "split_required", "deferred_budget"]},
          "slotId": {"type": ["string", "null"]},
          "weightedCost": {"type": "number", "minimum": 0}
        }
      }
    },
    "renderJobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deliverable", "format", "contentModuleIds", "modelCall"],
        "properties": {
          "deliverable": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "contentModuleIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "modelCall": {"const": false}
        }
      }
    },
    "costSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optimizedWeightedCost", "naivePerFormatWeightedCost", "avoidedWeightedCost", "savingsRate", "modelCalls", "renderJobs"],
      "properties": {
        "optimizedWeightedCost": {"type": "number", "minimum": 0},
        "naivePerFormatWeightedCost": {"type": "number", "minimum": 0},
        "avoidedWeightedCost": {"type": "number", "minimum": 0},
        "savingsRate": {"type": "number", "minimum": 0, "maximum": 1},
        "modelCalls": {"type": "integer", "minimum": 0},
        "renderJobs": {"type": "integer", "minimum": 0}
      }
    }
  }
}
