{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ningyi-ai.com/schemas/deletion-run/v1.json",
  "title": "Ningyi Deletion Run V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "scope", "ownerUserId", "targetSolutionIds", "status", "steps", "failure", "requestedAt", "completedAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid"},
    "scope": {"enum": ["solution", "account"]},
    "ownerUserId": {"type": "string", "format": "uuid"},
    "targetSolutionIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "status": {"enum": ["pending", "running", "retry_wait", "complete", "failed"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "attemptCount"],
        "properties": {
          "id": {"enum": ["revoke_access", "tombstone_primary", "purge_objects", "purge_derived", "anonymize_logs", "register_backup_tombstone", "verify_absence"]},
          "status": {"enum": ["pending", "running", "complete", "retry_wait", "failed"]},
          "attemptCount": {"type": "integer", "minimum": 0}
        }
      }
    },
    "failure": {"type": ["string", "null"]},
    "requestedAt": {"type": "integer", "minimum": 0},
    "completedAt": {"type": ["integer", "null"], "minimum": 0}
  }
}
