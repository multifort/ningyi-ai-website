{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ningyi-ai.com/schemas/ocr-result/v1.json",
  "title": "Ningyi OCR Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourcePath", "engine", "pages"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "sourcePath": {"type": "string", "minLength": 1},
    "derivedFromSourcePath": {"type": ["string", "null"], "minLength": 1},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "width", "height", "regions"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "bbox", "confidence", "kind"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1},
                "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "kind": {"enum": ["heading", "paragraph", "table", "caption", "unknown"]}
              }
            }
          }
        }
      }
    }
  }
}
