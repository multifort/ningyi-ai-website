{
  "benchmark_id": "BM-10",
  "minimum_structured_items": {"requirement": 12, "feature": 12, "phase": 2, "risk": 4},
  "maximum_runtime_seconds": 1800,
  "required_patterns": [
    {"id": "template_examples", "patterns": ["30.{0,3}60.{0,3}10", "示例", "(不得自动|非默认|不得作为默认)", "0\\.03%"]},
    {"id": "warranty_choice", "patterns": ["12.{0,6}24.{0,6}(个月|月)", "可选", "(无默认|不得默认|非默认)"]},
    {"id": "field_classification", "patterns": ["占位字段", "可选条款", "标准条款", "项目附件", "示例数字"]},
    {"id": "amount_boundaries", "patterns": ["500[,.]?000|50.{0,2}万", "2[,.]?000[,.]?000|200.{0,2}万", "(恰好|等于).{0,8}(500[,.]?000|50.{0,2}万)", "(恰好|等于).{0,8}(2[,.]?000[,.]?000|200.{0,2}万)"]},
    {"id": "sample_contracts", "patterns": ["CT-SYN-1001", "CT-SYN-1002", "CT-SYN-1003", "CT-SYN-1004", "CT-SYN-1005"]},
    {"id": "cumulative_approval", "patterns": ["金额", "非标准条款", "境外主体", "跨境数据", "(累计|叠加|并集).{0,8}(触发|审批|合并)"]},
    {"id": "mandatory_legal", "patterns": ["所有对外合同", "法务.{0,6}(审核|审批)", "标准模板.{0,8}(不能|不得).{0,6}(免除|跳过|免审)"]},
    {"id": "seal_lock", "patterns": ["全部审批完成", "(版本锁定|锁定合同版本)", "(后|方可|才能).{0,8}(用印|发起用印)"]},
    {"id": "permissions", "patterns": ["经办人.{0,12}(本人草稿|被退回版本)", "法务.{0,8}(管理|维护).{0,6}模板", "印章管理员.{0,12}已批准", "最小必要"]},
    {"id": "archive_package", "patterns": ["最终可编辑文件", "签署扫描件", "全部附件", "审批记录", "用印记录", "版本链"]},
    {"id": "retention", "patterns": ["(到期|终止).{0,10}10.{0,2}年", "(撤回|驳回).{0,10}3.{0,2}年", "模板版本.{0,8}永久", "(法律保全|诉讼|调查).{0,12}(暂停删除|停止删除)"]},
    {"id": "scope_boundary", "patterns": ["电子签名", "电子印章", "(不自动|不得自动).{0,8}(判断|判定).{0,6}(合法|是否合法)", "(谈判意见|付款|质保|赔偿|争议解决).{0,12}(不自动|不得自动|不在首期)"]}
  ],
  "prohibited_commitment_patterns": [
    {"id": "default_payment", "pattern": "(?:默认|必须)[^。；\\n]{0,12}30.{0,3}60.{0,3}10"},
    {"id": "default_warranty", "pattern": "(?:默认|必须)[^。；\\n]{0,10}24.{0,3}(?:个月|月)[^。；\\n]{0,8}质保"},
    {"id": "committed_penalty", "pattern": "(?:承诺|确定采用|必须采用)[^。；\\n]{0,12}0\\.03%"},
    {"id": "legal_exemption", "pattern": "标准模板[^。；\\n]{0,12}(?:免除|跳过|无需)[^。；\\n]{0,6}法务"},
    {"id": "single_trigger", "pattern": "多个审批条件[^。；\\n]{0,18}(?:只选|仅选|任选)[^。；\\n]{0,8}(?:一条|一个)"},
    {"id": "seal_before_approval", "pattern": "(?:审批未完成|版本未锁定)[^。；\\n]{0,12}(?:可以|允许)[^。；\\n]{0,6}用印"},
    {"id": "signature_page_only", "pattern": "(?:只|仅)[^。；\\n]{0,5}(?:保存|归档)[^。；\\n]{0,6}(?:盖章页|签字页)"},
    {"id": "excess_permission", "pattern": "(?:印章管理员[^。；\\n]{0,10}管理[^。；\\n]{0,4}模板|经办人[^。；\\n]{0,10}编辑[^。；\\n]{0,4}已批准合同)"},
    {"id": "out_of_scope_automation", "pattern": "首期[^。；\\n]{0,12}(?:自动判断条款是否合法|自动完成电子签名|自动完成电子印章)"}
  ]
}
