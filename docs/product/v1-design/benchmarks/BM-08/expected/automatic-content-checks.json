{
  "benchmark_id": "BM-08",
  "minimum_structured_items": {"requirement": 10, "feature": 10, "phase": 2, "risk": 3},
  "maximum_runtime_seconds": 1800,
  "required_patterns": [
    {"id": "sales_semantic_split", "patterns": ["管理销售额.{0,18}(扣除|减去).{0,8}退货", "管理销售额.{0,18}(剔除|不含).{0,8}(增值税|税)", "运营销售额|运营订单金额", "含税.{0,8}(未扣|不扣).{0,6}退货"]},
    {"id": "management_revenue", "patterns": ["12600000|1[,.]?260.{0,3}万", "300000|30.{0,3}万", "13%", "10884956|10[,.]?884[,.]?956|1[,.]?088\\.5.{0,2}万"]},
    {"id": "gross_margin", "patterns": ["7465000|7[,.]?465[,.]?000|746\\.5.{0,2}万", "31\\.4%", "毛利率"]},
    {"id": "repeat_purchase", "patterns": ["2100", "900", "42\\.9%", "CRM.{0,10}(统一客户ID|统一客户 ID)"]},
    {"id": "inventory_turnover", "patterns": ["45000000|4[,.]?500.{0,3}万", "75000000|7[,.]?500.{0,3}万", "54(?:\\.0)?.{0,2}天", "寄售库存.{0,10}(不纳入|不包含|不在首期范围)"]},
    {"id": "data_freshness", "patterns": ["T\\+1|T＋1", "08:30|08：30", "09:05|09：05", "35.{0,3}分钟"]},
    {"id": "identity_quality", "patterns": ["未映射.{0,8}(渠道账号|渠道账户)", "数据质量清单", "归并|映射"]},
    {"id": "access_control", "patterns": ["毛利率.{0,14}(财务|管理层)|(?:财务|管理层).{0,14}毛利率", "区域负责人.{0,12}(本区域|所属区域)", "公开大屏.{0,16}(隐藏|脱敏).{0,16}(客户标识|金额明细|毛利率)"]},
    {"id": "scope_boundary", "patterns": ["实时流处理.{0,10}(不包含|不建设|不在首期范围)", "自动修复.{0,8}主数据.{0,10}(不包含|不支持|不在首期范围)|主数据.{0,8}(不自动修复)", "不替代.{0,8}财务系统"]}
  ],
  "prohibited_commitment_patterns": [
    {"id": "conflated_sales", "pattern": "1260.{0,3}万[^。；\n]{0,20}(财务结算收入|管理销售额)"},
    {"id": "real_time_claim", "pattern": "(?:首期|经营看板)[^。；\n]{0,16}(提供|实现|支持)[^。；\n]{0,6}实时(?:数据|更新|同步)"},
    {"id": "channel_account_repeat", "pattern": "(?:直接|仅)[^。；\n]{0,8}(?:按|以)渠道账号[^。；\n]{0,12}(?:计算|统计)[^。；\n]{0,6}复购"},
    {"id": "public_sensitive_data", "pattern": "公开大屏[^。；\n]{0,16}(?:展示|开放)[^。；\n]{0,10}(?:毛利率|客户标识|金额明细)"},
    {"id": "replace_finance", "pattern": "(?:平台|经营看板)[^。；\n]{0,12}(?:替代|取代)财务系统"},
    {"id": "out_of_scope_automation", "pattern": "首期[^。；\n]{0,12}(?:自动修复客户主数据|纳入寄售库存|建设实时流处理)"}
  ]
}
