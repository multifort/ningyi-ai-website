{
  "benchmark_id": "BM-09",
  "minimum_structured_items": {"requirement": 12, "feature": 10, "phase": 2, "risk": 4},
  "maximum_runtime_seconds": 1800,
  "required_patterns": [
    {"id": "level_thresholds", "patterns": ["前12个完整自然月", "已结算净额", "银卡.{0,12}2[,.]?000", "金卡.{0,12}8[,.]?000", "钻石.{0,12}20[,.]?000"]},
    {"id": "level_timing", "patterns": ["每月1日", "升级.{0,8}当日生效", "降级.{0,10}30.{0,3}(天|个自然日)"]},
    {"id": "base_points", "patterns": ["每.{0,3}1.{0,3}元.{0,8}1.{0,3}分", "向下取整", "优惠券抵扣", "运费.{0,8}(不计入|不产生|不可积分)"]},
    {"id": "posting", "patterns": ["7.{0,3}(日|天).{0,8}(次日|后)", "02:00|02：00"]},
    {"id": "refund_rule", "patterns": ["退货.{0,12}原订单", "原活动规则", "积分.{0,8}(最低|下限).{0,5}0", "待人工处理"]},
    {"id": "expiration", "patterns": ["实际入账", "次年.{0,8}12月31日", "23:59:59|23：59：59", "2027-12-31"]},
    {"id": "sample_totals", "patterns": ["ORD-SYN-901", "基础.{0,4}1000.{0,5}活动.{0,4}1000.{0,8}2000", "ORD-SYN-902", "基础.{0,4}2200.{0,5}活动.{0,4}1500.{0,8}3700"]},
    {"id": "campaign_stacking", "patterns": ["新客.{0,8}100.{0,3}元券", "生日.{0,8}50.{0,3}元券", "互斥", "新客.{0,8}优先", "券抵扣.{0,8}不产生积分"]},
    {"id": "approval", "patterns": ["运营.{0,8}发起", "财务.{0,8}复核", "5000|5[,.]?000", "会员负责人.{0,8}审批"]},
    {"id": "scope_boundary", "patterns": ["积分转赠", "跨品牌积分", "付费会员", "不包含|不提供|不在首期范围"]}
  ],
  "prohibited_commitment_patterns": [
    {"id": "wrong_level_window", "pattern": "(?:等级|会员等级)[^。；\n]{0,16}(?:按|使用)(?:当年下单金额|自然年累计金额)"},
    {"id": "cap_base_points", "pattern": "1500.{0,3}分[^。；\n]{0,16}(?:截断|限制)[^。；\n]{0,6}基础积分"},
    {"id": "wrong_expiration_anchor", "pattern": "(?:按|以)(?:下单日|活动结束日)[^。；\n]{0,12}(?:计算|确定)[^。；\n]{0,8}到期"},
    {"id": "coupon_stack", "pattern": "(?:生日.{0,6}50.{0,3}元券|生日券)[^。；\n]{0,14}(?:叠加|同时使用)[^。；\n]{0,14}(?:新客.{0,6}100.{0,3}元券|新客券)"},
    {"id": "new_refund_rules", "pattern": "退货[^。；\n]{0,12}(?:按|使用)退款时[^。；\n]{0,10}(?:活动|规则)"},
    {"id": "customer_service_adjusts", "pattern": "客服[^。；\n]{0,10}(?:直接改分|直接调整积分)"},
    {"id": "out_of_scope_points", "pattern": "首期[^。；\n]{0,12}(?:提供|支持|包含)[^。；\n]{0,8}(?:积分转赠|跨品牌积分合并|自动豁免)"}
  ]
}
