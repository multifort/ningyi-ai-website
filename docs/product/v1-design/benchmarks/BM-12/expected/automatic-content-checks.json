{
  "benchmark_id": "BM-12",
  "minimum_structured_items": {"requirement": 16, "feature": 14, "phase": 3, "risk": 6},
  "maximum_runtime_seconds": 2100,
  "required_patterns": [
    {"id": "master_data", "patterns": ["CRM.{0,16}(客户法定名称|客户身份|商机|报价)", "ERP.{0,16}(信用额度|物料|税码)", "ERP.{0,16}(发运|发票|应收|付款)", "(主数据|所有权)"]},
    {"id": "architecture", "patterns": ["CRM.{0,8}(不得|不能).{0,8}直连.{0,5}ERP", "API.{0,3}网关", "集成.{0,5}(编排|服务)", "消息队列", "ERP.{0,3}适配器"]},
    {"id": "limits", "patterns": ["CRM.{0,12}120.{0,8}(请求|次).{0,4}分钟", "ERP.{0,12}60.{0,8}(请求|次).{0,4}分钟", "200.{0,3}条", "24.{0,3}小时"]},
    {"id": "webhook_security", "patterns": ["HMAC-SHA256", "10.{0,3}分钟", "event_id", "(去重|防重放)"]},
    {"id": "money_rule", "patterns": ["按行|行级", "含税.{0,12}(除以|÷).{0,8}(1.{0,3}税率|1\\+tax_rate)", "四舍五入.{0,8}2.{0,3}位", "(不得|禁止).{0,8}订单级.{0,8}(分摊|重分摊)"]},
    {"id": "sample_amounts", "patterns": ["INT-SYN-001", "11300", "10000", "1300", "INT-SYN-002", "2260", "2000", "260", "16272"]},
    {"id": "idempotency_samples", "patterns": ["INT-SYN-003", "(返回|复用).{0,8}(既有|已有).{0,5}订单", "INT-SYN-004", "409", "人工核对"]},
    {"id": "retry", "patterns": ["400.{0,12}(不自动重试|不重试)", "409.{0,12}(不自动重试|人工)", "5.{0,2}秒", "30.{0,2}秒", "2.{0,3}分钟", "10.{0,3}分钟", "第?5.{0,3}次.{0,8}死信"]},
    {"id": "unknown_outcome", "patterns": ["(超时|结果未知)", "external_order_no", "(先|必须).{0,8}查询", "(不得|禁止).{0,8}(再次创建|重复创建)"]},
    {"id": "reconciliation", "patterns": ["02:30|02：30", "15.{0,3}分钟", "全量.{0,8}对账", "(金额差异|币种差异|重复订单|死信)"]},
    {"id": "service_targets", "patterns": ["99\\.9%", "95%", "5.{0,3}分钟", "在线.{0,5}2.{0,2}年", "归档.{0,5}7.{0,2}年", "100.{0,3}条.{0,8}15.{0,3}分钟"]},
    {"id": "scope_boundary", "patterns": ["采购订单", "实时库存预留", "2025.{0,6}以前", "数据库直连", "(不包含|不在首期|排除)"]}
  ],
  "prohibited_commitment_patterns": [
    {"id": "crm_writes_erp_master", "pattern": "CRM[^。；\\n]{0,12}(?:修改|写入)[^。；\\n]{0,8}(?:信用额度|物料|税码|付款状态)"},
    {"id": "erp_owns_identity", "pattern": "ERP[^。；\\n]{0,12}(?:客户法定名称|联系人授权)[^。；\\n]{0,8}(?:主数据|权威)"},
    {"id": "direct_connection", "pattern": "CRM[^。；\\n]{0,8}(?:直接连接|直连)[^。；\\n]{0,6}(?:ERP|数据库)"},
    {"id": "name_creates_duplicate", "pattern": "名称[^。；\\n]{0,8}(?:不同|冲突)[^。；\\n]{0,10}(?:新建|创建)[^。；\\n]{0,6}客户"},
    {"id": "retry_unknown_create", "pattern": "超时[^。；\\n]{0,10}(?:直接|立即)[^。；\\n]{0,8}(?:再次创建|重复创建)"},
    {"id": "retry_bad_request", "pattern": "(?:400|409)[^。；\\n]{0,12}(?:自动重试|持续重试)"},
    {"id": "unbounded_retry", "pattern": "(?:429|5xx)[^。；\\n]{0,12}(?:无限|高频)[^。；\\n]{0,6}重试"},
    {"id": "temporary_master", "pattern": "物料映射[^。；\\n]{0,8}缺失[^。；\\n]{0,12}(?:临时创建|自动创建)[^。；\\n]{0,6}物料"},
    {"id": "lose_currency", "pattern": "外币订单[^。；\\n]{0,12}(?:只传|仅传)[^。；\\n]{0,8}人民币"},
    {"id": "order_level_rounding", "pattern": "含税[^。；\\n]{0,12}(?:订单级)[^。；\\n]{0,10}(?:分摊|重分摊)[^。；\\n]{0,6}尾差"},
    {"id": "crm_guesses_finance", "pattern": "CRM[^。；\\n]{0,12}(?:猜测|推断)[^。；\\n]{0,8}(?:发货|开票|回款|付款)"},
    {"id": "last_writer_wins", "pattern": "(?:冲突|字段冲突)[^。；\\n]{0,16}最后写入者获胜"}
  ]
}
