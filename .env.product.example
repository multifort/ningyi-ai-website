# Copy this file to .env.local for local development. Never commit real secrets.
PRODUCT_ENV_FILE_OVERRIDE=false
PRODUCT_APP_ORIGIN=http://127.0.0.1:3000

# Local development defaults to data/product.db and data/product-private when
# these are unset. Uncomment and replace them with absolute paths before the
# production configuration check or systemd deployment.
# PRODUCT_DB_PATH=/absolute/path/to/ningyi-ai-website/data/product.db
# PRODUCT_PRIVATE_STORAGE_PATH=/absolute/path/to/ningyi-ai-website/data/product-private
# PRODUCT_BACKUP_PATH=/absolute/path/to/ningyi-ai-website/data/product-backups

PRODUCT_SESSION_SECRET=replace-with-at-least-32-random-bytes
PRODUCT_WORKER_SECRET=replace-with-a-different-random-secret
PRODUCT_BACKUP_ENCRYPTION_KEY=replace-with-a-third-independent-random-secret
PRODUCT_DOWNLOAD_SECRET=replace-with-a-fourth-independent-random-secret

PRODUCT_FREE_MODEL_PROVIDER=openai
PRODUCT_FREE_MODEL=gpt-5.4-nano
PRODUCT_FREE_MODEL_VERSION=gpt-5.4-nano
PRODUCT_FREE_PROMPT_VERSION=free-analysis-v1
PRODUCT_FORMAL_MODEL_PROVIDER=openai
PRODUCT_FORMAL_MODEL=gpt-5.4
PRODUCT_FORMAL_MODEL_VERSION=gpt-5.4
PRODUCT_FORMAL_PROMPT_VERSION=formal-analysis-v1
OPENAI_API_KEY=replace-with-provider-key

# Keep fault probes off outside a dedicated acceptance environment.
PRODUCT_ACCEPTANCE_FAULT_PROBES=0
